{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "files": {
    "ignore": [
      "tests/**",
      "test-results/**",
      "reports/**",
      "reporters/excel-reporter.js",
      ".claude/**",
      ".cursor/**",
      ".windsurf/**",
      ".superset/**",
      "_bmad/**",
      ".test-flaky-history.json",
      ".test-history.json"
    ]
  },
  "organizeImports": {
    "enabled": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "noUnusedVariables": "warn",
        "noUnusedImports": "warn",
        "noEmptyPattern": "warn"
      },
      "security": {
        "noGlobalEval": "warn"
      },
      "performance": {
        "noDelete": "warn"
      },
      "a11y": {
        "useAltText": "warn",
        "useAnchorContent": "warn"
      },
      "style": {
        "useImportType": "off",
        "useNodejsImportProtocol": "warn"
      },
      "suspicious": {
        "noExplicitAny": "off"
      },
      "complexity": {
        "noBannedTypes": "warn"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "trailingCommas": "es5",
      "semicolons": "always",
      "arrowParentheses": "always"
    }
  }
}
